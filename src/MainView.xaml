<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
      x:Name="Root" TextElement.FontFamily="{StaticResource Ui}" TextOptions.TextFormattingMode="Display">

    <!-- Fond -->
    <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0E0F1A" Offset="0"/>
            <GradientStop Color="#141129" Offset="0.55"/>
            <GradientStop Color="#0C1320" Offset="1"/>
        </LinearGradientBrush>
    </Grid.Background>
    <Canvas IsHitTestVisible="False" ClipToBounds="True">
        <Ellipse Width="760" Height="760" Canvas.Left="-260" Canvas.Top="-330">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#4D7C3AED" Offset="0"/><GradientStop Color="#007C3AED" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="620" Height="620" Canvas.Left="700" Canvas.Top="-320">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#26EC4899" Offset="0"/><GradientStop Color="#00EC4899" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        </Ellipse>
    </Canvas>
    <Ellipse Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-380,-420" IsHitTestVisible="False">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#3306B6D4" Offset="0"/><GradientStop Color="#0006B6D4" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
    </Ellipse>

    <Grid x:Name="Shell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barre latérale -->
        <Border Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource Accent}">
                        <Border.Effect><DropShadowEffect Color="#7C3AED" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                        <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Glyph}" FontSize="19" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Étagère" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                        <TextBlock x:Name="VersionText" Text="Tout ton PC, bien rangé" FontSize="11.5" Foreground="{StaticResource FaintText}" Margin="0,-1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="BtnTidy" Style="{StaticResource Primary}" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Glyph}" FontSize="14" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="Ranger mon bureau"/>
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnFindGames" Style="{StaticResource Ghost}" Padding="8,9" ToolTip="Chercher les jeux installés (Steam, Epic Games)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Glyph}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Mes jeux" FontSize="12.5"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnAdd" Grid.Column="2" Style="{StaticResource Ghost}" Padding="8,9" ToolTip="Ajouter un programme (.exe) ou un raccourci">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Glyph}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Ajouter" FontSize="12.5"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <CheckBox x:Name="ChkMinimize" Style="{StaticResource Toggle}" Content="Réduire après un lancement" Margin="4,0,2,10"/>
                    <CheckBox x:Name="ChkStartup" Style="{StaticResource Toggle}" Content="Démarrer avec Windows" Margin="4,0,2,14"/>
                    <Button x:Name="BtnRestore" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="4,0,0,0" ToolTip="Remet sur le bureau les raccourcis qui en viennent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Glyph}" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Remettre sur le bureau" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavAll" Style="{StaticResource Nav}" Tag="all" IsChecked="True">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Glyph}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Tout"/>
                            <Border Grid.Column="2" CornerRadius="8" Background="#14FFFFFF" Padding="7,1"><TextBlock x:Name="CountAll" FontSize="11.5"/></Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavFav" Style="{StaticResource Nav}" Tag="fav">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE734;" FontFamily="{StaticResource Glyph}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Favoris"/>
                            <Border Grid.Column="2" CornerRadius="8" Background="#14FFFFFF" Padding="7,1"><TextBlock x:Name="CountFav" FontSize="11.5"/></Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavRecent" Style="{StaticResource Nav}" Tag="recent">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Glyph}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Récents"/>
                        </Grid>
                    </RadioButton>

                    <TextBlock Text="CATÉGORIES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FaintText}" Margin="12,22,0,8"/>

                    <RadioButton x:Name="NavGames" Style="{StaticResource Nav}" Tag="Jeux">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Glyph}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Jeux"/>
                            <Border Grid.Column="2" CornerRadius="8" Background="#14FFFFFF" Padding="7,1"><TextBlock x:Name="CountGames" FontSize="11.5"/></Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavApps" Style="{StaticResource Nav}" Tag="Applications">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource Glyph}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Applications"/>
                            <Border Grid.Column="2" CornerRadius="8" Background="#14FFFFFF" Padding="7,1"><TextBlock x:Name="CountApps" FontSize="11.5"/></Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavOther" Style="{StaticResource Nav}" Tag="Autres">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource Glyph}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Autres"/>
                            <Border Grid.Column="2" CornerRadius="8" Background="#14FFFFFF" Padding="7,1"><TextBlock x:Name="CountOther" FontSize="11.5"/></Border>
                        </Grid>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenu -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="BtnMin" Style="{StaticResource Caption}" Content="&#xE921;" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="BtnMax" Style="{StaticResource Caption}" Content="&#xE922;" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="BtnClose" Style="{StaticResource Caption}" Content="&#xE8BB;" Tag="close" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="36,0,36,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Tout" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                    <TextBlock x:Name="SubtitleText" FontSize="13.5" Foreground="{StaticResource SubText}" Margin="1,0,0,0"/>
                </StackPanel>
                <Border x:Name="SearchBorder" Grid.Column="1" Width="300" Height="42" CornerRadius="13" VerticalAlignment="Center"
                        Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Glyph}" FontSize="14" Foreground="{StaticResource SubText}"
                                   VerticalAlignment="Center" Margin="15,0,0,0"/>
                        <TextBlock x:Name="SearchHint" Text="Rechercher… (tape directement)" FontSize="14" Foreground="{StaticResource FaintText}"
                                   VerticalAlignment="Center" Margin="42,0,0,0" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" Margin="38,0,12,0" Background="Transparent" BorderThickness="0" FontSize="14"
                                 Foreground="{StaticResource Text}" CaretBrush="White" VerticalContentAlignment="Center"
                                 SelectionBrush="#8B5CF6"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="36,18,36,6">
                <Border Background="#0BFFFFFF" CornerRadius="11" Padding="3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SortName" Style="{StaticResource Chip}" Content="A → Z" Tag="name"/>
                        <RadioButton x:Name="SortRecent" Style="{StaticResource Chip}" Content="Joué récemment" Tag="recent"/>
                        <RadioButton x:Name="SortPopular" Style="{StaticResource Chip}" Content="Les plus lancés" Tag="popular"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource FaintText}" VerticalAlignment="Center"/>
                    <Slider x:Name="ZoomSlider" Style="{StaticResource Zoom}" Width="96" Minimum="0.7" Maximum="1.4" Margin="10,0"
                            LargeChange="0.1" ToolTip="Taille des tuiles (ou Ctrl + molette)"/>
                    <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource Glyph}" FontSize="15" Foreground="{StaticResource FaintText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="Scroller" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="27,8,22,24" Focusable="False">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="Cards" Focusable="False">
                    <ItemsControl.LayoutTransform><ScaleTransform x:Name="ZoomScale"/></ItemsControl.LayoutTransform>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><Button Style="{StaticResource Card}" Margin="9" ToolTip="{Binding Name}"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="NoResult" Grid.Row="3" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="15" Foreground="{StaticResource SubText}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="0,0,0,60"/>

            <!-- Étagère vide -->
            <StackPanel x:Name="EmptyState" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" MaxWidth="470"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="104" Height="104" CornerRadius="30" Background="{StaticResource Accent}" HorizontalAlignment="Center">
                    <Border.Effect><DropShadowEffect Color="#7C3AED" BlurRadius="50" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Glyph}" FontSize="46" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Ton étagère est vide" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Text}"
                           HorizontalAlignment="Center" Margin="0,30,0,10"/>
                <TextBlock FontSize="14.5" Foreground="{StaticResource SubText}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22"
                           Text="Range tous les raccourcis de ton bureau ici en un clic, ou laisse-moi chercher tes jeux Steam et Epic Games."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <Button x:Name="BtnEmptyTidy" Style="{StaticResource Primary}" Padding="20,12" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Glyph}" FontSize="14" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="Ranger mon bureau"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnEmptyGames" Style="{StaticResource Ghost}" Padding="20,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Glyph}" FontSize="14" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="Trouver mes jeux"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="Astuce : tu peux aussi glisser-déposer des programmes dans cette fenêtre." FontSize="12.5"
                           Foreground="{StaticResource FaintText}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>

    <!-- Boîte de dialogue -->
    <Grid x:Name="Overlay" Visibility="Collapsed">
        <Rectangle Fill="#B3060610"/>
        <Border Width="440" CornerRadius="20" Background="#1C1A2D" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="28,26"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect><DropShadowEffect Color="Black" BlurRadius="60" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
            <StackPanel>
                <TextBlock x:Name="DlgTitle" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                <TextBlock x:Name="DlgText" FontSize="14" Foreground="{StaticResource SubText}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0"/>
                <Border x:Name="DlgInputBorder" CornerRadius="11" Background="#12FFFFFF" BorderBrush="#8B5CF6" BorderThickness="1"
                        Height="42" Margin="0,16,0,0">
                    <TextBox x:Name="DlgInput" Margin="12,0" Background="Transparent" BorderThickness="0" FontSize="14"
                             Foreground="{StaticResource Text}" CaretBrush="White" VerticalContentAlignment="Center" SelectionBrush="#8B5CF6"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="DlgCancel" Style="{StaticResource Ghost}" Content="Annuler" Margin="0,0,10,0" MinWidth="100"/>
                    <Button x:Name="DlgOk" Style="{StaticResource Primary}" Content="OK" MinWidth="110"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Petite notification -->
    <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="248,0,0,30" Opacity="0"
            IsHitTestVisible="False" CornerRadius="14" Background="#F21E1B31" BorderBrush="#408B5CF6" BorderThickness="1" Padding="18,12">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Glyph}" FontSize="14" Foreground="#34D399" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="ToastText" FontSize="13.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Grid>
