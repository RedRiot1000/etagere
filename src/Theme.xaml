<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="Glyph">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Ui">Segoe UI Variable Display, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="Text" Color="#F4F4F8"/>
    <SolidColorBrush x:Key="SubText" Color="#9AA0B4"/>
    <SolidColorBrush x:Key="FaintText" Color="#6B7086"/>
    <SolidColorBrush x:Key="Line" Color="#1AFFFFFF"/>

    <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0"/>
        <GradientStop Color="#6366F1" Offset="0.5"/>
        <GradientStop Color="#06B6D4" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="Glow">#7C3AED</Color>
    <SolidColorBrush x:Key="AccentSolid" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AccentLight" Color="#A78BFA"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#408B5CF6"/>
    <RadialGradientBrush x:Key="Blob1"><GradientStop Color="#4D7C3AED" Offset="0"/><GradientStop Color="#007C3AED" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Blob2"><GradientStop Color="#26EC4899" Offset="0"/><GradientStop Color="#00EC4899" Offset="1"/></RadialGradientBrush>
    <RadialGradientBrush x:Key="Blob3"><GradientStop Color="#3306B6D4" Offset="0"/><GradientStop Color="#0006B6D4" Offset="1"/></RadialGradientBrush>
    <LinearGradientBrush x:Key="NavSel" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#478B5CF6" Offset="0"/>
        <GradientStop Color="#0A06B6D4" Offset="1"/>
    </LinearGradientBrush>

    <!-- Boutons -->
    <Style x:Key="Primary" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="16,11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border CornerRadius="12" Background="{DynamicResource Accent}">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource Glow}" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="hl" CornerRadius="12" Background="White" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hl" Property="Opacity" Value="0.12"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="hl" Property="Opacity" Value="0.22"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="#E3E5EE"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="12" Background="#0BFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#18FFFFFF"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#38FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#24FFFFFF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource FaintText}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#D8DAE5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="Button">
        <Setter Property="Foreground" Value="#C9CCD8"/>
        <Setter Property="FontFamily" Value="{StaticResource Glyph}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#16FFFFFF"/></Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Tag" Value="close"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation latérale -->
    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#B4B8C8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="GroupName" Value="nav"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="bd" CornerRadius="10" Background="Transparent" Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <Border x:Name="bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{DynamicResource Accent}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#0DFFFFFF"/>
                            <Setter Property="Foreground" Value="#E8E9F0"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavSel}"/>
                            <Setter TargetName="bar" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SubText}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="sort"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="12,6">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#E8E9F0"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#24FFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interrupteur -->
    <Style x:Key="Toggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource SubText}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border x:Name="track" Grid.Column="1" Width="34" Height="18" CornerRadius="9" Background="#26FFFFFF">
                            <Ellipse x:Name="knob" Width="12" Height="12" Fill="#B3FFFFFF" HorizontalAlignment="Left" Margin="3,0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Fill" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#D8DAE5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ligne cochable de la fenêtre de scan -->
    <Style x:Key="RowCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="bd" CornerRadius="10" Background="Transparent" Padding="8,7" Margin="0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5" BorderBrush="#40FFFFFF"
                                    Background="Transparent" HorizontalAlignment="Left">
                                <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="{StaticResource Glyph}" FontSize="11" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#0DFFFFFF"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="box" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Button">
        <Setter Property="Foreground" Value="#D8DAE5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8" Background="#16FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource Glyph}" FontSize="10" Margin="7,1,0,0" Opacity="0.6" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentSolid}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Curseur de taille -->
    <Style x:Key="BareRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FillRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}"/></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Zoom" TargetType="Slider">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="20" Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="#26FFFFFF"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource FillRepeat}"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource BareRepeat}"/></Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="14" Height="14" Fill="White"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barre de défilement fine -->
    <Style x:Key="ThinScroll" TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="t" CornerRadius="4" Background="#2EFFFFFF" Margin="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#55FFFFFF"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu clic droit -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#1D1B2E" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="6">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinWidth" Value="230"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Icon" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="#1CFFFFFF"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MenuSep" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator"><Border Height="1" Background="#1AFFFFFF" Margin="8,5"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#1D1B2E" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="7" Padding="10,6">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tuile d'un jeu / d'une appli (DataContext = Item) -->
    <Style x:Key="Card" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" Width="150" Height="225" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>

                        <Border x:Name="glow" CornerRadius="16" Background="#1A1830" Visibility="Hidden" Opacity="0">
                            <Border.Effect><DropShadowEffect Color="{DynamicResource Glow}" BlurRadius="30" ShadowDepth="0" Opacity="0.85"/></Border.Effect>
                        </Border>
                        <Border CornerRadius="16" Background="{Binding TileBrush}"/>

                        <!-- Icône (quand pas de jaquette) -->
                        <Grid Visibility="{Binding IconVisibility}" VerticalAlignment="Top" Margin="0,40,0,0">
                            <Ellipse Width="120" Height="120" Margin="0,-22,0,0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#26FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding Initial}" Visibility="{Binding InitialVisibility}" FontSize="46" FontWeight="Bold"
                                       Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-22,0,0"/>
                            <Image Source="{Binding Icon}" Width="76" Height="76" VerticalAlignment="Top" Margin="0,0,0,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>

                        <!-- Jaquette -->
                        <Border CornerRadius="16">
                            <Border.Background><ImageBrush ImageSource="{Binding Poster}" Stretch="UniformToFill"/></Border.Background>
                        </Border>

                        <Border CornerRadius="0,0,16,16" VerticalAlignment="Bottom" Height="96" Visibility="{Binding IconVisibility}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#D9080812" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{Binding Name}" Visibility="{Binding IconVisibility}" VerticalAlignment="Bottom" Margin="12,0,12,14" TextAlignment="Center"
                                   Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="17" LineStackingStrategy="BlockLineHeight"/>

                        <Border Visibility="{Binding StarVisibility}" Width="26" Height="26" CornerRadius="13" Background="#99000000"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0">
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource Glyph}" FontSize="12" Foreground="#FBBF24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Survol -->
                        <Grid x:Name="hover" Opacity="0">
                            <Border CornerRadius="16" Background="#26000000"/>
                            <Border Visibility="{Binding PlayVisibility}" CornerRadius="9" Background="#CC0B0B16" Padding="8,4"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8,10,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource Glyph}" FontSize="10.5" Foreground="{DynamicResource AccentLight}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding PlayInfo}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="0,0,16,16" VerticalAlignment="Bottom" Height="96">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#D9080812" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Bottom" Margin="12,0,12,14" TextAlignment="Center"
                                       Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="17" LineStackingStrategy="BlockLineHeight"/>

                            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Accent}" Margin="0,0,0,24">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Glyph}" FontSize="20" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </Border>
                        </Grid>
                        <Border x:Name="outline" CornerRadius="16" BorderThickness="1.5" BorderBrush="#14FFFFFF"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="glow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="outline" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
